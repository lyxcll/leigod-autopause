# 统一换行符，避免 Windows 上 clone 出来的脚本被 Bash 工具跑坏
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.vbs     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf

*.log     -text
.token_cache -text

# 图标是二进制，别做换行符转换
*.ico     -text
